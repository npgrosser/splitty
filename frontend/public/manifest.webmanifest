{
  "name": "Splitty",
  "short_name": "Splitty",
  "description": "GPU-accelerated terminal multiplexer",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "background_color": "#1e1e2e",
  "theme_color": "#252526",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
