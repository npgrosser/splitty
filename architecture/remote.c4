// The components of splitty-remote and their dependencies.
// A relationship between two components with a `module` means that code of the source may
// name the target's modules; architecture/check checks both directions.

model {
  extend splitty.remote {

    ssh = component 'ssh' {
      description 'Reaching a host with the system ssh (on Windows the system\'s OpenSSH, without a console window): the validated target (SR-13), the hardened command, stdio-only connections (no terminal, no agent, X11 or configured forwards), forward-only connections (-N, no terminal, agent or X11), relay-only connections (a command, no terminal, agent or X11) and the forwards a host\'s configuration adds (ssh -G), POSIX quoting and allowlists for the one command line the host\'s login shell parses, the Executor trait and what a failure means (127, host keys, refused logins).'
      metadata {
        module 'splitty_remote::ssh'
      }
    }

    install = component 'install' {
      description 'Installing the client\'s own server on a Linux or macOS host: one probe (kernel, architecture, $HOME, installed marker), payload sources (SPLITTY_REMOTE_PAYLOAD, archives per kernel and architecture built into the client by build.rs with build-time checksums, a static client itself for Linux hosts; uname -m aliases for x86_64 and aarch64), upload over stdin with the checksum verified on the host (sha256sum or shasum), ~/.local/share/splitty/remote/<version>/, removal of versions no process runs (/proc or ps); on macOS the server runs with SPLITTY_CONFIG_DIR=~/.config/splitty.'
      metadata {
        module 'splitty_remote::install'
        spec 'remote-hosts'
      }
    }

    handshake = component 'handshake' {
      description 'The format-2 handshake separates answering binary capabilities from daemon instance, transport and mux versions. No required port, endpoint path or credential crosses discovery; legacy metadata is diagnostic only.'
      metadata {
        module 'splitty_remote::handshake'
      }
    }

    bridge = component 'bridge' {
      description 'NativeBridge verifies framing and the expected service instance over a stdio-only SSH exec, using shared bounded peer queues and delivery credits. It admits carrier, opening and worker capacity before spawn; cleanup waits for the owned child and keeps a bounded stderr tail.'
      metadata {
        module 'splitty_remote::bridge'
      }
    }

    owner = component 'owner' {
      description 'One app-owned helper over raw pipes, with independently negotiated and bounded document streams; cancellation retains capacity until helper acknowledgement or actual child exit.'
      metadata { module 'splitty_remote::owner' }
    }

    tunnel = component 'tunnel' {
      description 'Native SSH setup and supervision shared by the explicit browser gateway and desktop clients: reserve capacity before installation, verify port-free discovery and native service identity, and reconnect without replaying application input. Updates conditionally stop only the checked older keeper-backed instance through its owner socket; stale discovery is refreshed and host-key/auth/protocol failures stop automatic retries. Also the failures\' messages and hints, the events of connect --json, and PortTunnel: one port forwarded by a forward-only ssh of its own (refused for a host whose configuration forwards ports), verified through a bounded fixed local-command marker after OpenSSH binds, then TCP/liveness and IPv6 checks; no multiplex reuse or backgrounding. Saved/explicit local ports and every automatically chosen candidate must be free on both supported loopback families, with checks repeated across handoff and rebuild. ReverseTunnel: one local port shared with a Linux host by a relay-only ssh of its own (-R to a Unix socket in the host\'s relay directory, the command remote-relay serve), established on the relay\'s ready line and kept alive by a heartbeat line every 10 seconds.'
      metadata {
        module 'splitty_remote::tunnel'
        spec 'cli'
      }
    }

    hosts = component 'hosts' {
      description 'The hosts a user knows: recent-hosts.json in the client\'s configuration directory (most recent first, at most 20, replaced atomically, owner-only) and the concrete Host names of ~/.ssh/config and the files it includes; the merged list for a host picker. Private remote-host-preferences.json stores optional display aliases and persistent hidden markers, remote-host-order.json the arranged order of the host groups (a file of its own, so older readers of the preferences keep their aliases); a cross-process file lock serializes recent, preference and catalog changes. Explicit connections reveal forgotten targets; hub reconnects preserve hiding.'
      metadata {
        module 'splitty_remote::hosts'
        spec 'remote-hosts'
      }
    }

    owner -> bridge 'Supervised helper carrier and observed child exit'
    owner -> ssh 'Validated fixed host targets for inner streams'
    owner -> splitty.transport.admission 'Independent opening and stream admission'
    owner -> splitty.transport.budget 'Retain chunk, envelope and diagnostic storage'
    owner -> splitty.transport.negotiation 'Negotiate each inner document connection'
    owner -> splitty.transport.peer 'Bounded carrier and independently credited inner peers'
    owner -> splitty.transport.queue 'App and document cancellation scopes'
    owner -> splitty.transport.wire 'Helper stream control and readiness'
    install -> ssh 'CommandLine, Executor, run_checked, allowlists'
    handshake -> ssh 'Executor, run_checked, SshError'
    handshake -> install 'Server'
    handshake -> splitty.transport.wire 'Native transport capability independent of mux compatibility'
    handshake -> splitty.transport.budget 'Reserve typed daemon metadata before parsing and retain it through connection setup'
    handshake -> splitty.transport.codec 'Measure retained daemon metadata without an intermediate allocation'
    tunnel -> ssh 'Ssh, run_checked, classify, SshError, the end of stderr'
    tunnel -> install 'Server, InstallError, prepare, Payload'
    tunnel -> handshake 'handshake, HandshakeError, RunningDaemon'
    tunnel -> bridge 'Verified native exec client, distinct from deliberate forwards'
    tunnel -> splitty.transport.admission 'Admit pending native backend setup and deliberate forwarding before any exec'
    tunnel -> splitty.transport.worker 'Count forward/reverse workers until observed exit, including cancelled setup'
    tunnel -> splitty.transport.budget 'Bound durable reservation parsing, process-view validation and forward stdout/diagnostic storage'
    tunnel -> splitty.transport.codec 'Measure reservation replacements before serialization'
    tunnel -> splitty.transport.queue 'Share cancellation and byte ownership through preparation and progress delivery'
    tunnel -> splitty.transport.negotiation 'Expected daemon instance and independent mux version'
    tunnel -> splitty.transport.wire 'Direct service purpose and bounded handshake deadline'
    hosts -> ssh 'SshTarget'
    bridge -> ssh 'Ssh, SshTarget, stdio-only options, the end of stderr'
    bridge -> install 'Server'
    bridge -> splitty.transport.admission 'Trusted carrier/opening/stream quotas before exec spawn'
    bridge -> splitty.transport.budget 'Retain received frames, stdout reader and diagnostics in the native connection budget'
    bridge -> splitty.transport.negotiation 'Framing and service identity verification over native child pipes'
    bridge -> splitty.transport.peer 'Shared bounded ordered carrier with independent credits'
    bridge -> splitty.transport.queue 'Connection-wide memory budget and close scope'
    bridge -> splitty.transport.wire 'Ready identity and bounded preparation progress'
    bridge -> splitty.transport.worker 'Owned exec process slot through observed exit'
    ssh -> splitty.transport.admission 'Admit setup processes before OS spawn; no worker wait queue'
    ssh -> splitty.transport.budget 'Reserve setup and diagnostic capture before spawn and retain output through caller consumption'
    ssh -> splitty.transport.worker 'Keep setup worker capacity through observed exit and cancellation'
    ssh -> splitty.transport.queue 'Native owner cancellation and byte budget across setup commands'
    ssh -> splitty.transport.wire 'Connection limits for source diagnostic accounting'
  }
}
