// People, external systems, and the system splitty with its containers and stores.

model {
  user = actor 'User' {
    description 'Developer working in terminals: splits panes, switches screens, runs shells and agents, locally or on a remote host.'
  }

  agent = actor 'AI agent' {
    #external
    description 'Claude Code and other coding agents. They run as programs in panes today; later they also use Splitty as a tool through the MCP server.'
  }

  remote_host = system 'Remote host' {
    #external
    description 'A VM or DevPod workspace reached over SSH (system OpenSSH client, the user\'s config and agent). Runs a Splitty daemon of its own, reachable through its private native socket over SSH exec pipes.'
  }

  wsl = system 'WSL 2' {
    #external
    description 'On Windows, the Linux distribution in which the server, the PTYs and the shells run; the desktop app itself stays native.'
  }

  splitty = system 'Splitty' {
    description 'Terminal multiplexer: the Rust server is the source of truth for screens, layouts and terminal sessions; the native desktop app and CLI are its clients.'

    core = container 'splitty-core' {
      technology 'Rust library, crates/splitty-core'
      description 'Workspace model and its reducer, PTY sessions, the session protocol and notifications, daemon state, configuration, themes and templates. Transport-agnostic; linked into the splitty binary, the native app (through splitty-client-core).'
    }

    server = container 'splitty binary' {
      technology 'Rust, Tokio, Axum, crates/splitty-server'
      description 'The `splitty` command: one terminal service with shared operations and independent client session loops, native streams and Unix control HTTP framing, embedded and daemon lifetimes; the CLI with its control commands; the control socket for processes in panes; SSH host connections and deliberate forwarding.'
    }



    remote = container 'splitty-remote' {
      technology 'Rust library, crates/splitty-remote'
      description 'Reaching a remote host over SSH, installing the client\'s server there and keeping a native SSH exec stream to its daemon; the hosts the user knows. Platform-neutral and free of the server crates: linked into the splitty binary for the hub, and into the native client through its embedded service for host connections.'
    }

    transport = container 'splitty-transport' {
      technology 'Rust library, crates/splitty-transport'
      description 'Platform-neutral native framing, negotiation and resource accounting. No PTY, server, browser or OS endpoint authority.'
    }

    client_core = container 'splitty-client-core' {
      technology 'Rust library, crates/splitty-client-core'
      description 'UI-free native client of the native desktop app: connection-scoped session delivery, the local and host workspace model, settings, viewer document and annotation state. On Linux and macOS it starts the server in-process (the embedded service) and talks to it over the same framed pipe and handshake a remote client uses; on Windows it starts the server in WSL 2 and does not link it.'
    }

    gpui = container 'splitty-gpui' {
      technology 'Rust, GPUI, crates/splitty-gpui'
      description 'The native desktop app and default desktop app: one window over the local service and opened hosts, with terminal, viewer and Markdown panes. Uses only splitty-client-core among the workspace crates; a separate offscreen web-engine experiment stays behind a feature.'
    }

    mcp = container 'MCP server' {
      #planned
      technology 'Rust'
      description 'From mcp-server: lets AI agents read terminals and drive the workspace through the control API.'
    }

    config_files = store 'Configuration' {
      technology 'TOML, YAML and JSON files, ~/.config/splitty'
      description 'config.toml with settings and shell profiles, custom themes, saved layout templates, recent-hosts.json, remote-host-preferences.json with display aliases and hidden markers, remote-host-order.json with the arranged order of the host groups, remembered remote screens and host catalogs, and remote-forwards.json with opt-in target/remote/local mappings, labels and enabled state (private atomic writes; no credentials or runtime errors).'
    }

    daemon_files = store 'Daemon files' {
      technology 'Files, ~/.config/splitty (mode 0700)'
      description 'daemon.json (discovery: instance, pid, private client/control sockets), state.json (the persisted workspace), daemon.log.'
    }
  }

  user -> splitty.server.main 'runs splitty commands'
  agent -> splitty.mcp 'reads terminals, drives the workspace' {
    technology 'MCP'
  }
  user -> splitty.gpui 'works in screens, panes and terminals'
  splitty.gpui -> splitty.client_core 'uses the native client and embedded service'
  splitty.client_core -> splitty.server 'links the server and starts it in-process on Linux and macOS (the embedded service), then connects over its native framed pipe'
  splitty.gpui -> wsl 'chooses the distribution and installs the backend that ships beside the executable in' {
    technology 'wsl.exe'
  }
  splitty.client_core -> wsl 'starts the server in, on Windows, and talks to it over native frames' {
    technology 'wsl.exe, stdio'
  }
  splitty.gpui -> splitty.config_files 'reads UI themes and terminal palettes from the themes directory'
  splitty.remote.tunnel -> remote_host 'discovers the daemon and carries native frames through SSH exec to its private socket' {
    technology 'SSH'
  }
  splitty.remote.install -> remote_host 'probes, uploads and installs the server in ~/.local/share/splitty/remote' {
    technology 'SSH, sh -c'
  }
  splitty.mcp -> splitty.server.control 'uses the control API'
  splitty.core.config -> splitty.config_files 'reads and writes'
  splitty.core.template -> splitty.config_files 'reads and writes templates'
  splitty.core.daemon -> splitty.daemon_files 'writes daemon.json and state.json'
  splitty.remote.hosts -> splitty.config_files 'records recent hosts'
}
