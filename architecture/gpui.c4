// The GPUI native desktop development window and retained fixture probe.

model {
  extend splitty.gpui {
    gpui_main = component 'gpui_main' {
      description 'Application entry point for the local workspace and optional fixture probe.'
      metadata { module 'splitty_gpui' }
    }

    gpui_app = component 'gpui_app' {
      description 'Legacy terminal and Markdown fixture probe.'
      metadata { module 'splitty_gpui::app' }
    }

    terminal = component 'terminal' {
      description 'Native terminal presentation with coherent zoom metrics, cached text shaping, local find editing and highlights, pointer geometry and admitted gesture lifetime, deliberate validated browser links, and byte-preserving session input routing.'
      metadata { module 'splitty_gpui::terminal' }
    }

    terminal_engine = component 'terminal_engine' {
      description 'Thread-confined Ghostty ownership, bounded local search and owned match spans, bounded owned hyperlink hits, terminal protocol state, requested mouse encoding and borrowed render snapshots.'
      metadata { module 'splitty_gpui::terminal_engine' }
    }

    gpui_workspace = component 'gpui_workspace' {
      description 'Screen controls, captured tab transfer menus, tab insertion geometry and scrolling, shortcuts, resolved appearance, canonical presentation root, stable pane entities, focused search ownership and one cancellable close prompt.'
      metadata { module 'splitty_gpui::workspace' }
    }

    gpui_appearance = component 'gpui_appearance' {
      description 'Bounded theme, UI font and zoom projection from service-owned appearance snapshots; chrome font settings remain separate from terminal typography.'
      metadata { module 'splitty_gpui::appearance' }
    }

    gpui_document = component 'gpui_document' {
      description 'Markdown text view with quote-anchored annotation marks.'
      metadata { module 'splitty_gpui::document' }
    }

    offscreen = component 'offscreen' {
      description 'Optional offscreen web-engine proof, composited as a native pane.'
      metadata { module 'splitty_gpui::offscreen' }
    }

    gpui_main -> gpui_app 'Construct and close the probe window'
    gpui_main -> gpui_workspace 'Construct the local workspace window'
    gpui_main -> splitty.client_core.native_workspace 'Join the native workspace runtime'
    gpui_main -> offscreen 'Run an engine child before opening the UI'
    gpui_app -> gpui_document 'Show Markdown and annotation marks'
    gpui_app -> offscreen 'Composite the offscreen engine frame under an overlay'
    gpui_app -> terminal 'Show terminal output and forward native input'
    terminal -> terminal_engine 'Borrow native terminal state and encode checked input'
    terminal -> splitty.client_core.external_links 'Validate bounded HTTP(S) targets before explicit platform dispatch'
    gpui_workspace -> terminal 'Keep one terminal view per pane identity'
    gpui_workspace -> gpui_appearance 'Convert resolved theme values for native chrome and terminal colors'
    gpui_workspace -> splitty.client_core.appearance 'Match owner and generation before applying resolved appearance'
    gpui_workspace -> splitty.client_core.client_shell_profiles 'Retain owner-bound service choices for the new-tab picker'
    gpui_appearance -> terminal 'Provide a plain terminal color configuration'
    gpui_appearance -> splitty.client_core.appearance 'Consume charged appearance snapshot values'
    gpui_appearance -> splitty.client_core.client_zoom 'Project confirmed display zoom and scope'
    gpui_workspace -> splitty.client_core.client_zoom 'Submit zoom intents and present confirmed scale'
    gpui_workspace -> splitty.client_core.native_workspace 'Submit captured transfer and assessed close intents; consume matching outcomes'
    gpui_workspace -> splitty.client_core.client_workspace 'Render the displayed canonical root with local tab and maximized-slot choice'
    gpui_workspace -> splitty.client_core.client_root 'Construct workspace identities in native navigation tests'
    gpui_app -> splitty.client_core.client_root 'Use the public native client API'
    gpui_document -> splitty.client_core.client_root 'Form a source-scoped annotation draft'
  }
}
