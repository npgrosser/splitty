// The native desktop app (GPUI), the default desktop app, and its retained fixture probe.

model {
  extend splitty.gpui {
    gpui_main = component 'gpui_main' {
      description 'Application entry point for the native multi-source window and optional fixture probe, observing one canonical Screen/pane/host title projection for the OS and window chrome. The pinned external Linux platform uses finite native-event batches and one buffered-event continuation so foreground workspace updates progress under sustained input without changing application queues. On Windows, the Kit title bar follows the projected application palette; a hidden startup window waits for accepted appearance, error or bounded timeout and builds its first scene before activation. Until the workspace arrives the window shows the startup phase or the failure that ended it.'
      metadata { module 'splitty_gpui' }
    }

    gpui_askpass = component 'gpui_askpass' {
      description 'Native SSH authentication and explicit host-key confirmation windows, one per question the local service (embedded or the WSL backend) waits on, as the workspace reads them; an answer or a dismissal goes back once.'
      metadata { module 'splitty_gpui::askpass' }
    }

    gpui_startup = component 'gpui_startup' {
      description 'Parse native workspace launch options before creating a window. On Windows without an explicit WSL target: choose the remembered or default supported distribution, install the backend that ships beside the executable when its version or checksum differs; this runs on its own thread started before the window, reports its phases, translates the SSH dialog path in the same inspection call and stops its wsl.exe calls when the window closes.'
      metadata { module 'splitty_gpui::startup' }
    }

    gpui_app = component 'gpui_app' {
      description 'Legacy terminal and Markdown fixture probe.'
      metadata { module 'splitty_gpui::app' }
    }

    terminal = component 'terminal' {
      description 'Native terminal presentation with coherent zoom metrics, cached text shaping, local find editing and highlights, pointer geometry and admitted gesture lifetime with local context intent and shared clipboard/search actions, source-aware deliberate links routed through workspace ownership for remote loopback opening, and byte-preserving input bound to an immutable source and terminal route. Focused PTY key context retains Tab input without changing editor traversal. A fixed-geometry passive surface reuses the painter without input, resizing or activity claims. A replacement connection receives fresh emulation before replay; same-connection hidden views remain retained.'
      metadata { module 'splitty_gpui::terminal' }
    }

    terminal_engine = component 'terminal_engine' {
      description 'Thread-confined Ghostty ownership, bounded local search and owned match spans, bounded owned hyperlink hits, terminal protocol state, requested mouse encoding and borrowed render snapshots.'
      metadata { module 'splitty_gpui::terminal_engine' }
    }

    gpui_workspace = component 'gpui_workspace' {
      description 'Single canonical Screen projection over WindowWorkspace selection, local-first source-grouped Drawer references with passive exact-host navigation, bounded port menus, captured remote Screen creation and separate popup/group intent lifetimes, one captured inline rename editor for local and live remote Screens, plus global navigation, source-qualified unread count and severity projection over a shared notification ledger, one bounded outgoing passive Screen during reversible navigation motion, captured same-source Screen drag and keyboard placement with transient measured row displacement, a dropped arrangement held until the service order arrives, and no second order owner, deliberate Hosts connection, live catalog, explicit host update confirmation and Ports controls, retained source-qualified terminal views and one identity-bound terminal context popup with separate retained presentation and live command authority, fixed-local controlled settings with separate appearance and notification observations plus local library controls, basic remote tab/split input and resize, default remote detach and assessed termination, plus local floating, transfer and template tools. Native Hosts uses a themed searchable master-detail browser with virtualized Screens and Ports, cached connect-and-open continuations fenced by view and owner, per-group creation, within-group screen clipping and whole-host drag motion. The window title carries workspace identity without an extra terminal header. Connecting, the Screens of a host and its ports open as small panels beside the Drawer that share the look of the context menus and one keyboard model; the Hosts browser is the manager behind them. Images and files pasted or dropped into a terminal or scratchpad go to the server of that pane and arrive as paths, and offered files are saved after the user chose Save, each shown as a window notice. A host group closes as a whole from its caption, its panel or the manager while its Screens keep running; the Hosts panel then shows how many Screens the host had open here and reopens them when the host is chosen.'
      metadata { module 'splitty_gpui::workspace' }
    }

    gpui_host_update = component 'gpui_host_update' {
      description 'Retain a captured host update request and worker-prepared plan, render the Kit confirmation with exact target and versions, and revoke stale or dismissed prompts without deciding backend update policy.'
      metadata { module 'splitty_gpui::workspace::host_update' }
    }

    gpui_appearance = component 'gpui_appearance' {
      description 'Theme catalog of bundled and user files (toolkit theme sets, Ghostty-format terminal palettes), workspace chrome derived from the toolkit theme and its optional splitty block, terminal palette selection, and the bounded UI font and zoom projection from service-owned settings; palette changes preserve terminal typography and history.'
      metadata { module 'splitty_gpui::appearance' }
    }

    gpui_document = component 'gpui_document' {
      description 'Markdown text view with quote-anchored annotation marks.'
      metadata { module 'splitty_gpui::document' }
    }

    offscreen = component 'offscreen' {
      description 'Optional offscreen web-engine proof, composited as a native pane.'
      metadata { module 'splitty_gpui::offscreen' }
    }

    gpui_main -> splitty.client_core.embedded 'Run as the embedded service\'s askpass helper before ordinary startup'
    gpui_askpass -> splitty.client_core.native_workspace 'The SSH questions the workspace publishes'
    gpui_workspace -> gpui_askpass 'Show the local service\'s SSH questions and send their answers'
    gpui_main -> gpui_app 'Construct and close the probe window'
    gpui_main -> gpui_startup 'Validate process options before platform startup'
    gpui_main -> splitty.client_core.owned_service 'Replace the default backend with the prepared WSL launch target on Windows'
    gpui_startup -> splitty.client_core.owned_service 'Construct the explicit platform backend configuration'
    gpui_main -> gpui_workspace 'Construct the native multi-source workspace window'
    gpui_main -> terminal 'Install focused PTY key context after Kit key bindings'
    gpui_main -> splitty.client_core.native_workspace 'Join the native workspace runtime'
    gpui_main -> splitty.client_core.client_workspace 'Construct the canonical title model in OS window observation tests'
    gpui_main -> offscreen 'Run an engine child before opening the UI'
    gpui_app -> gpui_document 'Show Markdown and annotation marks'
    gpui_app -> offscreen 'Composite the offscreen engine frame under an overlay'
    gpui_app -> terminal 'Show terminal output and forward native input'
    terminal -> terminal_engine 'Borrow native terminal state and encode checked input'
    terminal -> splitty.client_core.external_links 'Validate bounded HTTP(S) targets before explicit platform dispatch'
    terminal -> splitty.client_core.appearance 'Register the bundled terminal font as the terminal face'
    gpui_workspace -> terminal 'Keep source-scoped terminal views, rebind route geometry and subscribe to deliberate remote loopback link gestures and admitted local context intents'
    gpui_workspace -> gpui_appearance 'Convert resolved theme values for native chrome and terminal colors'
    gpui_workspace -> gpui_startup 'Read the WSL distribution of the local backend for editor links'
    gpui_host_update -> gpui_workspace 'Use the workspace view, captured focus and current destination'
    gpui_host_update -> splitty.client_core.client_hub 'Construct fixed-local host directory evidence in view tests'
    gpui_host_update -> splitty.client_core.client_workspace 'Read current typed offer and validate the prepared plan against the current source attempt'
    gpui_host_update -> splitty.client_core.native_workspace 'Send owner-bound request, confirm or dismiss intents; consume prepared or rejected replies'
    gpui_workspace -> splitty.client_core.client_notifications 'Supply window observation, admit source facts and render bounded unread projections'
    gpui_workspace -> splitty.client_core.appearance 'Match owner and generation before applying resolved appearance'
    gpui_workspace -> splitty.client_core.client_settings 'Build bounded typed settings edits and render service metadata choices'
    gpui_workspace -> splitty.client_core.client_annotations 'Anchor annotations in the shown document, describe selected passages and write the review of a viewer pane'
    gpui_workspace -> splitty.client_core.local_service 'Present field/domain-bound settings outcomes and independently accepted notification values and reset evidence'
    gpui_workspace -> splitty.client_core.client_shell_profiles 'Retain owner-bound service choices for the new-tab picker'
    gpui_workspace -> splitty.client_core.client_hub 'Present fixed-local host observations and retained Connect/name forms, submit validated metadata intents and match identified outcomes'
    gpui_workspace -> splitty.client_core.client_ports 'Project source-qualified Ports in Hosts and bounded Drawer menus; submit exact-local forwarding intents and consume verified revocable browser consent for retained host groups or terminal gestures'
    gpui_workspace -> splitty.client_core.external_links 'Capture validated development URLs before submitting source-qualified forwarding intent'
    gpui_workspace -> splitty.client_core.client_templates 'Review charged template drafts and match identified library replies'
    gpui_appearance -> terminal 'Provide a plain terminal color configuration'
    gpui_appearance -> splitty.client_core.appearance 'Consume charged appearance snapshot values'
    gpui_appearance -> splitty.client_core.client_zoom 'Project confirmed display zoom and scope'
    gpui_appearance -> splitty.client_core.client_settings 'Take the zoom levels from the service settings limits'
    gpui_workspace -> splitty.client_core.client_zoom 'Submit zoom intents and present confirmed scale'
    gpui_workspace -> splitty.client_core.native_workspace 'Send pasted or dropped files to the source of their pane and answer its file offers; submit fixed-local host and navigation intents including one owner-bound remote Screen creation request, exact captured local or remote Screen renames, source-bound terminal commands and assessed close/template intents; share window presence and user interaction for the PTY size policy, take over sizes and show each session at its PTY size; reject obsolete output and outcomes'
    gpui_workspace -> splitty.client_core.owned_service 'Pass the selected backend into the shared workspace worker'
    gpui_workspace -> splitty.client_core.client_workspace 'Render the selected canonical source root and all-source terminal routes without a second layout tree; bind Drawer actions to retained host groups, validate captured remote Screen creation and local or live remote rename targets, project canonical pending or missing references, navigate the shared current Hosts row projection by canonical target, and mark tabs, Drawer Screens, host groups and host Screen lists with the program status of each source, dropping a done or failed mark once its pane is watched'
    gpui_workspace -> splitty.client_core.client_root 'Consume charged source events and construct isolated native view fixtures'
    gpui_app -> splitty.client_core.client_root 'Use the public native client API'
    gpui_document -> splitty.client_core.client_root 'Form a source-scoped annotation draft'
  }
}
