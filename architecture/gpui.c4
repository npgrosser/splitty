// The GPUI native desktop development window and retained fixture probe.

model {
  extend splitty.gpui {
    gpui_main = component 'gpui_main' {
      description 'Application entry point for the local workspace and optional fixture probe.'
      metadata { module 'splitty_gpui' }
    }

    gpui_app = component 'gpui_app' {
      description 'Legacy terminal and Markdown fixture probe.'
      metadata { module 'splitty_gpui::app' }
    }

    terminal = component 'terminal' {
      description 'Native terminal presentation, cached text shaping and session input routing.'
      metadata { module 'splitty_gpui::terminal' }
    }

    terminal_engine = component 'terminal_engine' {
      description 'Thread-confined Ghostty ownership, terminal protocol state and borrowed render snapshots.'
      metadata { module 'splitty_gpui::terminal_engine' }
    }

    gpui_workspace = component 'gpui_workspace' {
      description 'Screen controls and shortcuts, borrowed canonical presentation root, stable pane entities and one cancellable close prompt for pane, Screen and owned window.'
      metadata { module 'splitty_gpui::workspace' }
    }

    gpui_document = component 'gpui_document' {
      description 'Markdown text view with quote-anchored annotation marks.'
      metadata { module 'splitty_gpui::document' }
    }

    offscreen = component 'offscreen' {
      description 'Optional offscreen web-engine proof, composited as a native pane.'
      metadata { module 'splitty_gpui::offscreen' }
    }

    gpui_main -> gpui_app 'Construct and close the probe window'
    gpui_main -> gpui_workspace 'Construct the local workspace window'
    gpui_main -> splitty.client_core.native_workspace 'Join the native workspace runtime'
    gpui_main -> offscreen 'Run an engine child before opening the UI'
    gpui_app -> gpui_document 'Show Markdown and annotation marks'
    gpui_app -> offscreen 'Composite the offscreen engine frame under an overlay'
    gpui_app -> terminal 'Show terminal output and forward native input'
    terminal -> terminal_engine 'Borrow native terminal state and encode checked input'
    gpui_workspace -> terminal 'Keep one terminal view per pane identity'
    gpui_workspace -> splitty.client_core.native_workspace 'Submit assessed close intent and wait for matching approval or settlement'
    gpui_workspace -> splitty.client_core.client_workspace 'Render the displayed canonical root with local tab and maximized-slot choice'
    gpui_workspace -> splitty.client_core.client_root 'Construct workspace identities in native navigation tests'
    gpui_app -> splitty.client_core.client_root 'Use the public native client API'
    gpui_document -> splitty.client_core.client_root 'Form a source-scoped annotation draft'
  }
}
