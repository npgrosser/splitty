// Views. All use auto-layout. Planned elements are dashed and faded, external ones muted.

views {

  view index {
    title 'Context'
    description 'Splitty, the people who use it and the systems around it.'
    include *
    style element.tag = #external {
      color muted
    }
    style element.tag = #planned {
      border dashed
      opacity 40%
    }
  }

  view containers of splitty {
    title 'Containers'
    description 'The crates, the web frontend, the native desktop app and the stores, with the planned MCP server.'
    include *
    style element.tag = #external {
      color muted
    }
    style element.tag = #planned {
      border dashed
      opacity 40%
    }
  }

  view core of splitty.core {
    title 'splitty-core components'
    description 'Allowed dependencies inside the core. The mux is pure; only effect_runner touches pty.'
    include splitty.core.*
    rank sink { ids, shell_profiles }
  }

  view transport of splitty.transport {
    title 'splitty-transport components'
    description 'Framing, verified service admission and bounded delivery shared by native carriers.'
    include splitty.transport.*
  }

  view client_core of splitty.client_core {
    title 'splitty-client-core components'
    description 'UI-free native client connection, viewer state and embedded service adapter.'
    include splitty.client_core.*, splitty.client_core.* -> splitty.core.*, splitty.client_core.* -> splitty.server.*, splitty.client_core.* -> splitty.transport.*, splitty.client_core.* -> splitty.remote.*
  }

  view gpui of splitty.gpui {
    title 'splitty-gpui components'
    description 'The native desktop app and the client core it uses.'
    include splitty.gpui.*, splitty.gpui.* -> splitty.client_core.*
  }

  view connections {
    title 'Connection components'
    description 'Code dependencies implementing native and SSH connections. These are modules, not runtime processes; docs/networking.md shows the physical transports and their lifetimes.'
    autoLayout LeftRight
    style element.tag = #external {
      color muted
    }
  }

  view server of splitty.server {
    title 'splitty-server components'
    description 'The components of the splitty binary and the core components they use. The composition root view shows what main uses.'
    include splitty.server.*, splitty.server.* -> splitty.core.*, splitty.server.* -> splitty.remote.*
    exclude splitty.server.main -> *
  }

  view remote of splitty.remote {
    title 'splitty-remote components'
    description 'Reaching a host over SSH, installing the server there, the tunnel, the bridge and the known hosts, with the server components that use them.'
    include splitty.remote.*, splitty.server.main, splitty.server.host, splitty.server.hub
  }

  view main_root of splitty.server.main {
    title 'Composition root: splitty binary'
    description 'main.rs and everything it uses.'
    include splitty.server.main, splitty.server.main -> splitty.server.*, splitty.server.main -> splitty.core.*, splitty.server.main -> splitty.remote.*
    autoLayout LeftRight
  }
}
