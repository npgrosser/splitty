// The components of splitty-gui (the Tauri desktop app) and their dependencies, also into
// splitty-core and splitty-server, which it links on macOS and Linux only, and into
// splitty-remote, which it links on every platform. A relationship between two components with a
// `module` means that code of the source may name the target's modules; architecture/check checks
// both directions.

model {
  extend splitty.desktop {

    app_main = component 'app_main' {
      description 'Binary entry point (main.rs): sets the WebKitGTK workaround on Linux and calls run.'
      metadata {
        module 'splitty_gui'
      }
    }

    app = component 'app' {
      description 'Composition root of the desktop app (lib.rs): windows, navigation, capabilities and remote commands; on macOS/Linux an always app-owned embedded runtime with explicit session/job shutdown and no daemon or keeper discovery; on Windows the WSL bridge.'
      metadata {
        module 'splitty_tauri_lib'
      }
    }

    client_ipc = component 'client_ipc' {
      description 'Native-owned document proofs, fixed backend/window policies and connection admission; bounded byte channels and a direction-checked relay to an assigned native service or child; revokes stale documents while retaining slots through actual cleanup.'
      metadata { module 'splitty_tauri_lib::client_ipc' spec 'access-control' }
    }

    editor = component 'editor' {
      description 'Explicit local/SSH file and folder handoff to VS Code or Zed, and of SSH folders to an SFTP client: validates editor choice, target, absolute path, file/folder kind and optional WSL distribution, constructs a fixed URI and dispatches it to the OS. Never a terminal-link opener.'
      metadata {
        module 'splitty_tauri_lib::editor'
        spec 'desktop-remote'
      }
    }

    downloads = component 'downloads' {
      description 'The main window\'s downloads by their blob: URL, with where each was saved (the destination asked for where the webview reports no path, as on macOS), the most recent 32; reveal_download shows a finished one in the file manager, never a path the page names, and never tells the page the path.'
      metadata {
        module 'splitty_tauri_lib::downloads'
        spec 'access-control'
      }
    }

    login_path = component 'login_path' {
      description 'On macOS and Linux, when the desktop and not a terminal started the app: asks the user\'s login shell ($SHELL -l -i) once for its PATH, within 5 seconds and up to a marker, and puts its entries in front of the inherited ones before anything else starts, so ssh and the ProxyCommand of the SSH configuration find what the shell startup adds. Only PATH is taken.'
      metadata {
        module 'splitty_tauri_lib::login_path'
        spec 'server-modes'
      }
    }

    navigation = component 'navigation' {
      description 'Exact packaged entries by native document role; bounded app-owned popout windows tied to the current parent document, with native close/navigation teardown and no independent command grant; main-only blob downloads and external web links; remote windows never execute host content.'
      metadata {
        module 'splitty_tauri_lib::navigation'
      }
    }

    capability = component 'capability' {
      description 'Packaged main and remote window capabilities: main shell controls and document-authenticated application commands; remote windows receive only the assigned native transport surface, without network-origin grants.'
      metadata {
        module 'splitty_tauri_lib::capability'
        spec 'access-control'
      }
    }

    remote = component 'remote' {
      description 'Packaged remote windows with fixed-host native providers; coalesced opens and cancellation, bounded progress watches, document-owned launcher requests, private storage and reconnect state without navigation.'
      metadata {
        module 'splitty_tauri_lib::remote'
        spec 'desktop-remote'
      }
    }

    windows_wsl = component 'windows_wsl' {
      description 'Windows bridge: provisions the selected WSL 2 distribution with checksums and starts one app-owned native owner helper over raw pipes; cancels owned provisioning before awaiting startup and never kills unrelated WSL work.'
      metadata {
        module 'splitty_tauri_lib::windows_wsl'
        spec 'server-modes'
      }
    }

    app -> client_ipc 'Native window policy, private bootstrap and IPC providers'
    client_ipc -> navigation 'Exact packaged document authority before command dispatch'
    client_ipc -> splitty.remote.owner 'App-owned WSL helper connection'
    client_ipc -> splitty.remote.install 'Native SSH payload selection'
    client_ipc -> splitty.remote.tunnel 'Port-free SSH preparation with charged progress'
    editor -> client_ipc 'Document proof and main-only shell action'
    downloads -> client_ipc 'Document-owned download reveal'
    remote -> splitty.transport.admission 'Bound initial remote launcher work before spawning tasks'
    remote -> splitty.transport.budget 'Retain the bounded latest progress snapshot through consumption'
    remote -> splitty.transport.wire 'Typed connection preparation progress'
    remote -> client_ipc 'Fixed host providers and current launcher proof'
    remote -> app 'Guarded packaged remote window construction'
    windows_wsl -> splitty.remote.owner 'Persistent app-owned helper over wsl.exe pipes'
    windows_wsl -> splitty.transport.admission 'Bound WSL operations before spawning blocking tasks'
    windows_wsl -> splitty.transport.budget 'Retain operation permits through actual blocking task completion'
    windows_wsl -> splitty.transport.worker 'Share global worker admission and observed-exit cleanup for synchronous WSL provisioning'
    windows_wsl -> splitty.transport.queue 'Revoke provisioning and negotiation before waiting for startup cleanup'
    app_main -> app 'run'
    app -> splitty.server.service 'Shared owned embedded Runtime and awaited shutdown'
    app -> navigation 'Packaged role navigation, external links and blob download guards'
    app -> login_path 'adopt'
    app -> capability 'main_window'
    app -> editor 'open_remote_editor, open_local_editor'
    app -> downloads 'Downloads, reveal_download'
    editor -> splitty.remote.ssh 'SshTarget'
    client_ipc -> splitty.remote.ssh 'Validate main-window host intent and retain fixed remote targets'
    client_ipc -> splitty.transport.admission 'Share native handle/opening ceilings'
    client_ipc -> splitty.transport.queue 'Revoke each connection context on document/backend change'
    client_ipc -> splitty.transport.negotiation 'Validate assigned service readiness before exposing a live handle'
    client_ipc -> splitty.transport.wire 'Assigned purpose and service identity'
    client_ipc -> splitty.transport.budget 'Prepaid bounded chunk storage and payload lease transfer'
    client_ipc -> splitty.transport.peer 'Ordered framing, direction-checked relay and awaited shutdown'
    client_ipc -> splitty.transport.codec 'Real byte-channel regression fixtures'
    client_ipc -> splitty.transport.flow 'Consumption credits in byte-channel regression fixtures'
    client_ipc -> splitty.remote.bridge 'Owned native child connection and observed process exit'
    client_ipc -> splitty.server.native 'Assigned embedded native client and awaited service cleanup'
    client_ipc -> splitty.server.service 'Embedded runtime and role in native stream regression tests'
    client_ipc -> splitty.core.pty 'Local terminals in the isolated embedded stream regression'
    app -> remote 'Remotes, remote_hosts, remote_open, remote_cancel'
    app -> windows_wsl 'WindowsWslState, distribution list, start and switch'
    remote -> navigation 'Native-assigned remote document role'

    // Into splitty-remote (every platform)

    remote -> splitty.remote.tunnel 'open, supervise, Connected, Event, Failure, Progress, GIVE_UP_AFTER'
    remote -> splitty.remote.hosts 'known, record_recent, default_ssh_dir, KnownHost'
    remote -> splitty.remote.ssh 'Ssh, SshTarget'

    // Into the core and the server (macOS and Linux)

    app -> splitty.core.config 'HomeConfig, load and themes_dir for initial window appearance'
    app -> splitty.core.pty 'LocalTerminals for app-owned sessions, never keeper adoption'
    app -> splitty.core.theme 'resolve_theme'
    app -> splitty.server.cli 'In-process lifetime tests query the owned control socket'
    app -> splitty.server.control 'Per-process owner socket for the embedded runtime'
    remote -> splitty.core.config 'config_dir (recent hosts, shared with the CLI)'
  }
}
