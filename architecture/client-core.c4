// The UI-free native client and its dependencies on the existing service crates.

model {
  extend splitty.client_core {
    api_stream = component 'api_stream' {
      description 'Concrete embedded or owned API-only stream, sharing typed authority validation and request transactions.'
      metadata { module 'splitty_client_core::api_stream' }
    }
    owned_service = component 'owned_service' {
      description 'Explicit validated WSL child arguments or Unix embedded startup; one owned backend with separate session/API streams, explicit one-attempt host update intent and joined observed cleanup.'
      metadata { module 'splitty_client_core::owned_service' }
    }
    api_stream -> splitty.core.native_api 'Validate operation role and arguments against the shared contract'
    api_stream -> splitty.server.native 'Delegate embedded API streams on Unix'
    api_stream -> splitty.remote.owner 'Delegate owned API streams on Windows'
    api_stream -> splitty.transport.budget 'Retain response decoding leases'
    api_stream -> splitty.transport.codec 'Admit bounded typed API reply decoding'
    api_stream -> splitty.transport.peer 'Expose sender budgeting to bounded typed decoders'
    api_stream -> splitty.transport.wire 'Return typed native Reply envelopes'
    owned_service -> api_stream 'Open an independent owned API stream'
    owned_service -> appearance 'Pass window OS scheme into local reads'
    owned_service -> local_service 'Initialize the common auxiliary job scheduler'
    owned_service -> connection 'Return the common session client'
    owned_service -> client_root 'Create the existing Unix embedded backend'
    owned_service -> splitty.remote.owner 'Start, open and join the existing app-owned helper'
    owned_service -> splitty.remote.ssh 'Accept an already validated host target for the existing owned adapter'
    owned_service -> splitty.transport.budget 'Preserve charged host progress ownership'
    owned_service -> splitty.transport.wire 'Return existing typed host progress envelopes'
    owned_service -> splitty.transport.queue 'Cancel startup while retaining its cleanup future'
    owned_service -> splitty.core.protocol 'Verify the helper mux version'
    native_workspace -> owned_service 'Open and join local and deliberately requested host streams through existing service ownership'
    native_workspace -> hub 'Schedule owner-bound host metadata jobs and passive directory updates independently of terminal and settings streams'
    native_workspace -> api_stream 'Retain local hub API setup through cancellation'
    native_workspace -> splitty.transport.queue 'Revoke retained host and local API setup before joining owned cleanup'
    native_workspace -> splitty.transport.budget 'Retain charged host progress and diagnostics across source publication'
    native_workspace -> splitty.transport.negotiation 'Classify typed host preparation failures after retained setup completes'
    native_workspace -> splitty.remote.ssh 'Validate exact known host targets before deliberate connection'
    native_workspace -> splitty.transport.wire 'Validate host readiness and preserve charged transport close reasons'
    native_workspace -> splitty.core.theme 'Verify independent appearance delivery during a pending hub read'
    local_service -> api_stream 'Keep one auxiliary stream and retained jobs across cancellation'
    local_service -> splitty.transport.budget 'Retain bounded assigned-backend version metadata'
    local_service -> splitty.core.native_api 'Use shared home settings, metadata and theme operation authority'
    appearance -> api_stream 'Read existing appearance and theme contracts on either platform'
    appearance -> splitty.core.native_api 'Use fixed typed home and theme operations'
    client_shell_profiles -> api_stream 'Read bounded profile snapshots on either platform'
    client_shell_profiles -> splitty.core.native_api 'Use the existing profiles operation'
    client_templates -> api_stream 'Perform identified template jobs on either platform'
    client_templates -> splitty.core.native_api 'Use the existing typed library operations'

    client_root = component 'client_root' {
      description 'Public library API and module re-exports.'
      metadata { module 'splitty_client_core' }
    }

    connection = component 'connection' {
      description 'Connection-scoped native session delivery, capability-gated raw terminal input and bounded command sender, including relative Screen placement without a replacement order list.'
      metadata { module 'splitty_client_core::connection' }
    }

    appearance = component 'appearance' {
      description 'Charged local effective settings, bounded metadata and catalog choices, independent terminal palette source identity, and typed single-field editor intents; UI appearance remains separate from terminal color selection.'
      metadata { module 'splitty_client_core::appearance' }
    }

    local_service = component 'local_service' {
      description 'One owned auxiliary API stream with coalesced owner-bound backend-version reads and fair appearance/profile reads, bounded single-field settings FIFO and cross-path field exclusion, identified zoom/Drawer/template jobs, charged replies, explicit uncertainty reconciliation without replay and joined cancellation cleanup.'
      metadata { module 'splitty_client_core::local_service' }
    }

    hub = component 'hub' {
      description 'One local API stream for passive owner-bound host-directory reads and bounded typed metadata writes; charged last-good snapshots, coalesced generations, separate identified outcomes without replay and joined cleanup.'
      metadata { module 'splitty_client_core::hub' }
    }

    client_ports = component 'client_ports' {
      description 'Explicit local-owner outbound forwarding with bounded independent per-mapping API jobs, independent charged active/saved snapshots, authoritative acknowledgement revisions, and exact-source revocable browser continuations; no tunnel ownership or automatic forwarding.'
      metadata { module 'splitty_client_core::ports' }
    }
    native_workspace -> splitty.server.hub 'Gate the real forwarding service adapter for worker concurrency tests'
    native_workspace -> splitty.remote.bridge 'Type the fixture connector without opening remote Screen transports'
    native_workspace -> splitty.remote.handshake 'Type the forbidden fixture handshake and daemon operations'
    native_workspace -> splitty.remote.install 'Type the forbidden fixture preparation and daemon operations'
    native_workspace -> splitty.remote.tunnel 'Retain service-owned port reservations in gated forwarding fixtures'
    native_workspace -> splitty.transport.admission 'Type the forbidden fixture Screen bridge admission'
    native_workspace -> client_ports 'Compose identified local-owner forwarding commands, passive invalidation and joined cancellation'
    client_ports -> client_workspace 'Validate immutable source and terminal origins and join connection-owned discovery'
    client_ports -> api_stream 'Decode bounded existing forwarding contracts and retain independent requests'
    client_ports -> owned_service 'Own mapping and passive setup/request/cleanup carriers'
    client_ports -> external_links 'Rewrite admitted HTTP(S) development URLs to verified localhost mappings'
    client_ports -> splitty.core.native_api 'Use existing LocalHub forwarding operations and response bounds'
    client_ports -> splitty.remote.ssh 'Validate canonical mapping targets before effects'
    client_ports -> splitty.transport.budget 'Charge retained replies and bounded admitted request allocations'
    client_ports -> splitty.transport.codec 'Reserve typed response decoding before allocation'
    client_ports -> splitty.transport.queue 'Revoke retained stream setup and request contexts during cleanup'
    client_ports -> splitty.transport.wire 'Validate existing reply envelopes and construct bounded fixture responses'
    client_ports -> appearance 'Use isolated in-memory service fixtures for forwarding scheduler tests'
    client_ports -> client_root 'Own fixture service cleanup through the public embedded service seam'
    client_ports -> hub 'Reuse the bounded scripted native API peer for acknowledgement regression tests'

    client_templates = component 'client_templates' {
      description 'Bounded immutable charged template drafts/catalogs and explicit list/load/extract/save/delete jobs; no workspace policy or direct file storage.'
      metadata { module 'splitty_client_core::templates' }
    }

    client_shell_profiles = component 'client_shell_profiles' {
      description 'Charged service-owned profile snapshots and bounded native presentation admission; no command resolution.'
      metadata { module 'splitty_client_core::shell_profiles' }
    }

    client_document = component 'client_document' {
      description 'Versioned viewer document reads and annotation data scoped to their source connection.'
      metadata { module 'splitty_client_core::document' }
    }

    external_links = component 'external_links' {
      description 'Pure bounded absolute HTTP(S) target admission and normalization; no gesture or platform effects.'
      metadata { module 'splitty_client_core::external_links' }
    }

    client_zoom = component 'client_zoom' {
      description 'Pure bounded display zoom levels, scope projection and keyboard intent steps.'
      metadata { module 'splitty_client_core::zoom' }
    }

    client_workspace = component 'client_workspace' {
      description 'Source-qualified view keys and immutable execution tokens; common local all-catalog or remote explicit-open SourceWorkspace collections, WindowWorkspace global selection and aggregate admission, capability-gated service-owned local Screen order with mutation-watermarked catalog refresh and window-owned remote reference order available offline, bounded host-update offers and captured confirmation facts, canonical tiled/floating Screen projections, bounded coherent cross-Screen route collection, captured transfer, floating action and exact tab placement settlement, ordered relative Screen and captured group navigation, captured template replacement with separate pending presentation and full-scope close impact assessment.'
      metadata { module 'splitty_client_core::workspace' }
    }

    native_workspace = component 'native_workspace' {
      description 'Native workspace runtime: one owned local service and ordered connection, immutable source command admission before effects, source-scoped charged events and attachment delivery, worker-owned WindowWorkspace with one common SourceRuntime for session commands, observations and controls, local-owner captured Screen placement dispatch without navigation or uncertain-command replay, ordered model-before-delivery effects, identified host metadata preparation with request-scoped and global browse withdrawal, one-use host-update confirmation and cleanup-before-replacement with unconfirmed outcomes and connect-only reconciliation, identified transfer, floating and zoom outcomes, checked placement and close settlement including channel-owned startup consent, independent settings outcomes, verified shutdown and retained attachment and visibility controls.'
      metadata { module 'splitty_client_core::native_workspace' }
    }

    embedded = component 'embedded' {
      description 'Unix embedded service composition and lifecycle for the native client.'
      metadata { module 'splitty_client_core::embedded' }
    }

    client_templates -> local_service 'Reuse charged API response decoding'
    client_templates -> connection 'Validate captured extraction Screen identifiers'
    client_templates -> appearance 'Use isolated real-service fixtures for library tests'
    client_templates -> splitty.core.template 'Reuse template data, storage contract and command filtering'
    client_templates -> splitty.core.mux 'Reject drafts that cannot produce the supported canonical layout'
    client_templates -> splitty.core.ids 'Supply bounded validation-only pane identities'
    client_templates -> splitty.server.native 'Perform explicit library API jobs on the owned stream'
    client_templates -> splitty.server.service 'Use the existing authenticated template operations'
    client_templates -> splitty.transport.budget 'Retain typed and derived template allocation leases'
    client_templates -> splitty.transport.wire 'Retain reply leases through typed decoding'
    local_service -> client_templates 'Schedule one fair bounded template library job'
    client_workspace -> client_templates 'Prepare immutable drafts without duplicating library ownership'
    client_workspace -> splitty.transport.budget 'Retain charged remote catalogs, derived template plans and shared window staging permits'
    client_workspace -> splitty.remote.ssh 'Validate exact admitted host identities without rewriting them'
    client_workspace -> splitty.core.native_api 'Bound remote catalog decoding before typed allocation'
    native_workspace -> client_templates 'Route identified library requests and results'
    native_workspace -> splitty.core.template 'Seed isolated saved-template fixtures in runtime tests'
    client_root -> connection 'Expose the native client API'
    client_root -> appearance 'Expose charged appearance snapshots'
    client_root -> local_service 'Expose the owned local settings API client'
    local_service -> client_zoom 'Resolve queued zoom intents against current settings'
    native_workspace -> client_zoom 'Carry identified zoom intents and independent outcomes'
    local_service -> appearance 'Read appearance independently and reuse in-memory fixtures'
    hub -> api_stream 'Serialize retained directory reads and bounded metadata jobs on one owned stream'
    hub -> client_workspace 'Capture immutable local execution tokens in host metadata requests and outcomes'
    hub -> splitty.core.native_api 'Use the shared directory and existing host metadata operations'
    hub -> splitty.remote.ssh 'Validate canonical target identities without opening SSH'
    hub -> splitty.remote.hosts 'Validate typed host preference acknowledgements against the submitted metadata intent'
    hub -> splitty.transport.budget 'Retain charged snapshots and admit validation scratch'
    hub -> splitty.transport.wire 'Exercise bounded native directory replies in tests'
    hub -> splitty.core.daemon 'Describe an owned fake native endpoint in directory tests'
    local_service -> client_shell_profiles 'Read independently charged profile snapshots'
    local_service -> splitty.server.native 'Own one API stream and await cleanup'
    local_service -> splitty.server.service 'Use the real embedded API role in tests'
    local_service -> connection 'Verify settings broadcasts alongside real session delivery in tests'
    local_service -> splitty.core.shell_profiles 'Construct typed profile fixtures'
    local_service -> splitty.core.config 'Build isolated settings reply fixtures'
    local_service -> splitty.core.theme 'Supply valid theme replies during reconciliation tests'
    local_service -> splitty.core.daemon 'Describe an owned fake native endpoint in tests'
    local_service -> splitty.core.protocol 'Use the current handshake version in fake-peer tests'
    local_service -> splitty.transport.wire 'Validate API reply kind and status'
    local_service -> splitty.transport.negotiation 'Exercise real native admission in fake-peer tests'
    local_service -> splitty.transport.peer 'Script uncertainty and stream loss without a second client protocol'
    local_service -> splitty.transport.queue 'Own isolated fake-peer resource accounting'
    client_shell_profiles -> local_service 'Reuse bounded typed API response decoding'
    client_shell_profiles -> splitty.core.shell_profiles 'Present the existing service profile contract'
    client_shell_profiles -> splitty.transport.budget 'Keep profile data charged through presentation'
    appearance -> local_service 'Reuse bounded typed response decoding'
    appearance -> splitty.core.config 'Project existing appearance and Drawer preferences without write-on-load'
    appearance -> splitty.core.theme 'Decode the service-resolved theme'
    appearance -> splitty.server.native 'Own one API-only stream and await its cleanup'
    appearance -> splitty.server.service 'Use fixed read-only operations and in-memory service fixtures'
    appearance -> splitty.transport.budget 'Retain typed snapshot allocation leases'
    appearance -> splitty.transport.wire 'Exercise malformed and oversized API replies in tests'
    appearance -> connection 'Verify independent session delivery in real-service tests'
    appearance -> splitty.core.mux 'Construct an isolated workspace in real-service tests'
    appearance -> splitty.core.protocol 'Construct and observe isolated service events in tests'
    appearance -> splitty.core.pty 'Own the isolated test service backend'
    appearance -> splitty.core.shell_profiles 'Build explicit test shell settings'
    appearance -> splitty.core.template 'Keep test template paths isolated'
    appearance -> splitty.core.effect_runner 'Construct the isolated test service effect runner'
    appearance -> splitty.server.client_session 'Verify API reads preserve session broadcasts'
    appearance -> splitty.server.hub 'Keep test hub paths isolated'
    client_root -> client_document 'Expose viewer document API'
    client_root -> client_workspace 'Expose the local workspace model'
    client_root -> embedded 'Expose the embedded service adapter on Unix'
    connection -> splitty.core.mux 'Serialize typed screen operations'
    connection -> splitty.core.protocol 'Share terminal byte-input capability and size bounds'
    connection -> splitty.server.native 'Use the embedded native session client on Unix'
    connection -> splitty.remote.owner 'Use an owned remote native connection'
    connection -> splitty.transport.budget 'Retain event and attachment byte charges'
    connection -> splitty.transport.codec 'Bound decoded session JSON'
    connection -> splitty.transport.peer 'Receive and send native frames'
    connection -> splitty.transport.wire 'Frame kinds and negotiated service readiness'
    client_document -> connection 'Route versioned reads through their owning client'
    client_document -> appearance 'Use isolated real-service fixtures to reject reused document identities from another connection'
    client_document -> client_root 'Open independent fixture clients through the public embedded service seam'
    client_document -> splitty.transport.budget 'Retain document bytes and pending read capacity'
    client_workspace -> client_root 'Use public client, screen and event types'
    client_workspace -> connection 'Use shared command validation'
    client_workspace -> splitty.core.ids 'Identify panes and split nodes'
    client_workspace -> splitty.core.mux 'Use canonical screen layout, operations and validation'
    client_workspace -> splitty.transport.codec 'Measure aggregate staged snapshot data before retaining typed models'
    client_workspace -> splitty.transport.wire 'Bound one workspace collection by the transport frame ceiling'
    client_workspace -> splitty.core.pty 'Gate real-service tests on PTY availability'
    client_workspace -> appearance 'Reuse an isolated in-memory service for launch inheritance tests'
    client_workspace -> hub 'Verify confirmed metadata removal preserves open model bindings in an isolated integration test'
    client_workspace -> owned_service 'Own and close the isolated service fixture used by the metadata removal regression'
    client_workspace -> client_shell_profiles 'Bound explicit launch profile identifiers'
    native_workspace -> local_service 'Poll fair owner-bound settings without consuming terminal events'
    native_workspace -> client_shell_profiles 'Publish charged choices and bound admitted launch fallback notices'
    native_workspace -> appearance 'Poll owner-bound appearance without consuming session events'
    native_workspace -> embedded 'Own appearance fixture service cleanup in runtime tests'
    native_workspace -> splitty.core.protocol 'Read Screen placement capability before admission and broadcast same-service settings events in runtime tests'
    native_workspace -> splitty.core.config 'Verify persistence in an isolated child process'
    native_workspace -> client_workspace 'Collect and commit coherent routes, admit captured transfers and revalidate close impact'
    native_workspace -> connection 'Reject commands with missing or obsolete source authority before effects'
    native_workspace -> splitty.core.ids 'Confirm captured pane identity after the ordered close barrier'
    native_workspace -> splitty.core.mux 'Exercise external Screen transfers against the authoritative store in runtime tests'
    native_workspace -> splitty.core.pty 'Gate embedded worker terminal tests on PTY availability'
    native_workspace -> client_root 'Own an isolated service and ordered native client'
    embedded -> splitty.remote.ssh 'Open the exact admitted target through the existing connector'
    embedded -> splitty.transport.budget 'Preserve charged host progress ownership'
    embedded -> connection 'Return a connection scoped to the embedded service'
    embedded -> api_stream 'Open the independent local directory API stream'
    embedded -> splitty.transport.queue 'Pass retained cancellation context into API setup'
    embedded -> splitty.core.protocol 'Inject old-peer capability greetings in compatibility tests'
    embedded -> appearance 'Carry the local OS color preference into settings initialization'
    embedded -> local_service 'Open one owned auxiliary settings client'
    embedded -> client_root 'Use public event and screen types in embedded probe tests'
    embedded -> splitty.server.control 'Start and stop the isolated control channel'
    embedded -> splitty.server.native 'Connect an owned native session stream'
    embedded -> splitty.server.service 'Build and close the embedded service runtime'
    embedded -> splitty.core.pty 'Use local PTY terminals for the embedded service'
    embedded -> splitty.transport.wire 'Assert connection byte ceilings in embedded probe tests'
  }
}
