// The UI-free native client and its dependencies on the existing service crates.

model {
  extend splitty.client_core {
    client_root = component 'client_root' {
      description 'Public library API and module re-exports.'
      metadata { module 'splitty_client_core' }
    }

    connection = component 'connection' {
      description 'Connection-scoped native session delivery and bounded command sender.'
      metadata { module 'splitty_client_core::connection' }
    }

    client_document = component 'client_document' {
      description 'Versioned viewer document reads and annotation data scoped to their source connection.'
      metadata { module 'splitty_client_core::document' }
    }

    client_workspace = component 'client_workspace' {
      description 'Connection-wide catalog and admission, per-screen snapshots, local choices, session routes and identity-scoped close impact assessment.'
      metadata { module 'splitty_client_core::workspace' }
    }

    native_workspace = component 'native_workspace' {
      description 'Native workspace runtime: one owned service, ordered connection, checked close admission and settlement, verified shutdown, attachment and visibility retries.'
      metadata { module 'splitty_client_core::native_workspace' }
    }

    embedded = component 'embedded' {
      description 'Unix embedded service composition and lifecycle for the native client.'
      metadata { module 'splitty_client_core::embedded' }
    }

    client_root -> connection 'Expose the native client API'
    client_root -> client_document 'Expose viewer document API'
    client_root -> client_workspace 'Expose the local workspace model'
    client_root -> embedded 'Expose the embedded service adapter on Unix'
    connection -> splitty.core.mux 'Serialize typed screen operations'
    connection -> splitty.server.native 'Use the embedded native session client on Unix'
    connection -> splitty.remote.owner 'Use an owned remote native connection'
    connection -> splitty.transport.budget 'Retain event and attachment byte charges'
    connection -> splitty.transport.codec 'Bound decoded session JSON'
    connection -> splitty.transport.peer 'Receive and send native frames'
    connection -> splitty.transport.wire 'Frame kinds and negotiated service readiness'
    client_document -> connection 'Route versioned reads through their owning client'
    client_document -> splitty.transport.budget 'Retain document bytes and pending read capacity'
    client_workspace -> client_root 'Use public client, screen and event types'
    client_workspace -> connection 'Use shared command validation'
    client_workspace -> splitty.core.ids 'Identify panes and split nodes'
    client_workspace -> splitty.core.mux 'Use canonical screen layout, operations and validation'
    client_workspace -> splitty.core.pty 'Gate real-service tests on PTY availability'
    native_workspace -> client_workspace 'Reconcile catalogs and routes; revalidate captured close impact before submission'
    native_workspace -> splitty.core.ids 'Confirm captured pane identity after the ordered close barrier'
    native_workspace -> client_root 'Own an isolated service and ordered native client'
    embedded -> connection 'Return a connection scoped to the embedded service'
    embedded -> client_root 'Use public event and screen types in embedded probe tests'
    embedded -> splitty.server.control 'Start and stop the isolated control channel'
    embedded -> splitty.server.native 'Connect an owned native session stream'
    embedded -> splitty.server.service 'Build and close the embedded service runtime'
    embedded -> splitty.core.pty 'Use local PTY terminals for the embedded service'
    embedded -> splitty.transport.wire 'Assert connection byte ceilings in embedded probe tests'
  }
}
